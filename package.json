    "i18next-browser-languagedetector": "^8.2.1",
    "lucide-react": "^0.475.0",
    "luxon": "^3.7.2",
    "radix-ui": "^1.3.2",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-hook-form": "^7.55.0",
    "react-i18next": "^17.1.0",
    "react-router": "^7.2.0"
