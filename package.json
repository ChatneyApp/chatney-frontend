  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --open http://localhost:5173/client",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "test": "jest --passWithNoTests",
    "lint": "eslint .",
    "lint:soft": "eslint . --quiet",
    "lint:fix": "eslint . --fix",
    "graphql:generate": "graphql-codegen",
    "graphql:watch": "graphql-codegen --watch",
    "graphql:check": "graphql-codegen && git diff --exit-code src/graphql/generated",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build"
  },
  "dependencies": {
